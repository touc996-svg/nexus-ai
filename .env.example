# NEXUS AI local configuration
NEXUS_DEMO_MODE=false
NEXUS_MODEL=qwen3:1.7b
NEXUS_REASONING_EFFORT=none
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=1
EMBEDDING_MODEL=nomic-embed-text
NEXUS_EMBEDDING_DIMENSION=768
NEXUS_EMBEDDING_TIMEOUT=45
NEXUS_EMBEDDING_RETRIES=1
NEXUS_RAG_MIN_SCORE=0.15
NEXUS_MEMORY_HISTORY_LIMIT=16
NEXUS_EVALUATION_PATH=artifacts/agent_evaluation_latest.json
APP_ENV=development
# NEXUS_API_KEY=generate-a-long-random-secret   # operator key (admin role): every user's data and the system routes
# NEXUS_API_KEYS=<24+ char key>=alice,<24+ char key>=bob   # per-user keys (user role): own data only, 403 on system routes
# NEXUS_KEYSTORE_ENABLED=true   # also accept keys from `python -m app.security.keystore` (hashed, expiring, revocable);
#                               # turns authentication on, so NEXUS_API_KEY (break-glass) is still required
# Bearer tokens (JWT, HS256 only; this is not OIDC). The first three are required together; turns authentication on.
# NEXUS_JWT_SECRETS=<secret of 32+ bytes>[,<previous secret, while rotating>]
# NEXUS_JWT_ISSUER=https://tokens.example.com
# NEXUS_JWT_AUDIENCE=nexus-api
# NEXUS_JWT_LEEWAY_SECONDS=30
# NEXUS_JWT_MAX_LIFETIME_SECONDS=86400
# Set NEXUS_REQUIRE_API_KEY=false only for trusted local development.
NEXUS_RATE_LIMIT_PER_MINUTE=120
# NEXUS_RATE_LIMIT_PER_IDENTITY_PER_MINUTE=120   # per credential owner, after authentication; default: the value above
NEXUS_MAX_REQUEST_BYTES=26214400
# Comma-separated exact origins, e.g. https://your-frontend.example.com
NEXUS_CORS_ORIGINS=
# Maximum extracted/indexed document text size (characters).
NEXUS_RAG_MAX_DOCUMENT_CHARS=2000000

# Database. Unset = local SQLite file (tables created automatically). For PostgreSQL (e.g. Neon) set the connection string
# from your provider's dashboard in the environment or a secret manager; never commit it:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# NEXUS_DB_AUTO_CREATE=false   # PostgreSQL default; the schema is applied with `alembic upgrade head`
# DB_POOL_SIZE=5  DB_MAX_OVERFLOW=5  DB_POOL_TIMEOUT=30  DB_POOL_RECYCLE=300  DB_CONNECT_TIMEOUT=10
