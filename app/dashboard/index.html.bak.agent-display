
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#080d1a">
    <title>NEXUS AI | Intelligent Workspace</title>

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --bg: #080d1a;
            --panel: #111a2d;
            --panel-light: #17233a;
            --border: #273750;
            --cyan: #67e8f9;
            --blue: #0891b2;
            --text: #f1f5f9;
            --muted: #94a3b8;
            --green: #4ade80;
            --red: #f87171;
        }

        body {
            margin: 0;
            font-family: Inter, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        header {
            padding: 22px 7%;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(17, 26, 45, 0.8);
        }

        header h1 {
            margin: 0;
            color: var(--cyan);
            letter-spacing: 2px;
            font-size: 25px;
        }

        .status {
            color: var(--green);
            font-size: 13px;
            font-weight: 600;
        }

        main {
            max-width: 1100px;
            margin: 45px auto;
            padding: 20px;
        }

        .intro {
            margin-bottom: 32px;
        }

        .intro h2 {
            font-size: 34px;
            margin-bottom: 8px;
        }

        .intro p {
            color: var(--muted);
        }

        .agents {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 28px;
        }

        .agent {
            background: var(--panel);
            border: 1px solid var(--border);
            padding: 22px;
            border-radius: 14px;
            transition: 0.2s;
        }

        .agent:hover {
            border-color: var(--cyan);
            transform: translateY(-3px);
        }

        .agent h3 {
            color: var(--cyan);
            margin-top: 0;
        }

        .agent p {
            color: var(--muted);
            line-height: 1.5;
            font-size: 14px;
        }

        .agent-tag {
            display: inline-block;
            margin-top: 8px;
            color: var(--green);
            font-size: 12px;
        }

        .panel {
            background: var(--panel);
            border: 1px solid var(--border);
            padding: 28px;
            border-radius: 16px;
        }

        .panel h2 {
            margin-top: 0;
        }

        label {
            display: block;
            margin: 20px 0 8px;
            font-size: 14px;
            font-weight: 600;
        }

        select,
        textarea {
            width: 100%;
            padding: 14px;
            border-radius: 9px;
            border: 1px solid var(--border);
            background: var(--bg);
            color: white;
            font: inherit;
        }

        select:focus,
        textarea:focus {
            outline: 1px solid var(--cyan);
            border-color: var(--cyan);
        }

        textarea {
            min-height: 145px;
            resize: vertical;
        }

        button {
            margin-top: 18px;
            background: var(--blue);
            color: white;
            border: 0;
            padding: 14px 24px;
            border-radius: 9px;
            cursor: pointer;
            font-weight: bold;
            font-size: 14px;
            transition: 0.2s;
        }

        button:hover {
            background: #0e7490;
        }

        button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .results {
            margin-top: 30px;
        }

        .results h2 {
            margin-bottom: 15px;
        }

        .result-card {
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 16px;
            overflow-wrap: anywhere;
        }

        .result-card h3 {
            color: var(--cyan);
            margin-top: 0;
        }

        .result-content {
            white-space: pre-wrap;
            line-height: 1.7;
            color: #dbeafe;
            font-size: 14px;
        }

        .result-card.final {
            border-color: var(--blue);
            background: #101d32;
        }

        .placeholder {
            color: var(--muted);
        }

        .error {
            color: var(--red);
        }

        .loading {
            color: var(--cyan);
            animation: pulse 1.3s infinite;
        }

        @keyframes pulse {
            50% { opacity: 0.45; }
        }

        footer {
            text-align: center;
            padding: 28px;
            color: var(--muted);
            font-size: 12px;
        }

        @media (max-width: 600px) {
            header {
                padding: 18px 20px;
            }

            main {
                margin: 20px auto;
            }

            .intro h2 {
                font-size: 27px;
            }

            .panel {
                padding: 19px;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>NEXUS AI</h1>
    <span class="status">● PLATFORM ONLINE</span>
</header>

<main>

    <section class="intro">
        <h2>Your Intelligent Workspace.</h2>
        <p>One platform. Three specialized AI agents. One unified workflow.</p>
    </section>

    <section class="agents">

        <div class="agent">
            <h3>Enterprise AI</h3>
            <p>Business analysis, strategic planning, documents and operations.</p>
            <span class="agent-tag">● Business Intelligence</span>
        </div>

        <div class="agent">
            <h3>Personal AI</h3>
            <p>Personal planning, productivity and everyday assistance.</p>
            <span class="agent-tag">● Personal Assistant</span>
        </div>

        <div class="agent">
            <h3>Cybersecurity AI</h3>
            <p>Security analysis, threat assessment and defensive recommendations.</p>
            <span class="agent-tag">● Security Intelligence</span>
        </div>

    </section>

    <section class="panel">

        <h2>Talk to NEXUS</h2>
        <p class="placeholder">
            Select an agent and describe what you need.
        </p>

        <label for="agent">Choose your AI agent</label>

        <select id="agent">
            <option value="enterprise">Enterprise AI</option>
            <option value="personal">Personal AI</option>
            <option value="cybersecurity">Cybersecurity AI</option>
            <option value="team">All Three Agents</option>
        </select>

        <label for="message">Your message</label>

        <textarea
            id="message"
            placeholder="What would you like NEXUS AI to do?"
        ></textarea>

        <button id="sendButton" onclick="sendMessage()">
            Send Message
        </button>

        <section class="results" id="results">
            <h2>Results</h2>

            <div class="result-card">
                <div class="placeholder" id="result">
                    Your AI response will appear here.
                </div>
            </div>
        </section>

    </section>

</main>

<footer>
    NEXUS AI — Enterprise Intelligence Platform
</footer>

<script>
    const resultArea = document.getElementById("results");
    const sendButton = document.getElementById("sendButton");

    function createResultCard(title, content, isFinal = false) {
        const card = document.createElement("div");
        card.className = isFinal
            ? "result-card final"
            : "result-card";

        const heading = document.createElement("h3");
        heading.textContent = title;

        const body = document.createElement("div");
        body.className = "result-content";

        if (typeof content === "string") {
            body.textContent = content;
        } else {
            body.textContent = JSON.stringify(content, null, 2);
        }

        card.appendChild(heading);
        card.appendChild(body);

        return card;
    }

    function extractAgentResponse(agentData) {
        if (!agentData) return "No response available.";

        if (typeof agentData === "string") return agentData;

        return agentData.response
            || agentData.error
            || JSON.stringify(agentData, null, 2);
    }

    function displayResults(data, selectedAgent) {
        resultArea.innerHTML = "";

        if (selectedAgent === "team") {
            const finalReport = data.final_report
                || data.final_summary;

            if (finalReport) {
                resultArea.appendChild(
                    createResultCard(
                        "NEXUS FINAL REPORT",
                        finalReport,
                        true
                    )
                );
            }

            const agents = data.agents || {};

            const agentNames = {
                enterprise: "Enterprise AI",
                personal: "Personal AI",
                cybersecurity: "Cybersecurity AI"
            };

            for (const [key, value] of Object.entries(agents)) {
                resultArea.appendChild(
                    createResultCard(
                        agentNames[key] || key,
                        extractAgentResponse(value)
                    )
                );
            }

            if (!finalReport && Object.keys(agents).length === 0) {
                resultArea.appendChild(
                    createResultCard(
                        "NEXUS RESPONSE",
                        data.message || data
                    )
                );
            }

        } else {
            resultArea.appendChild(
                createResultCard(
                    "AI RESPONSE",
                    extractAgentResponse(data)
                )
            );
        }
    }

    async function sendMessage() {
        const agent = document.getElementById("agent").value;
        const message = document.getElementById("message").value.trim();

        if (!message) {
            resultArea.innerHTML = "";
            resultArea.appendChild(
                createResultCard(
                    "Message Required",
                    "Please enter a message before sending."
                )
            );
            return;
        }

        sendButton.disabled = true;
        sendButton.textContent = "NEXUS is processing...";

        resultArea.innerHTML = "";

        const loading = document.createElement("p");
        loading.className = "loading";
        loading.textContent = "Processing your request...";
        resultArea.appendChild(loading);

        try {
            const endpoint = agent === "team"
                ? "/team"
                : `/agents/${agent}`;

            const response = await fetch(endpoint, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ message })
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(
                    data.detail || data.error || "Request failed"
                );
            }

            displayResults(data, agent);

        } catch (error) {
            resultArea.innerHTML = "";

            const errorCard = createResultCard(
                "Request Error",
                error.message
            );

            errorCard.querySelector("div").classList.add("error");
            resultArea.appendChild(errorCard);

        } finally {
            sendButton.disabled = false;
            sendButton.textContent = "Send Message";
        }
    }
</script>

</body>
</html>
