
import json
import re

from app.core.llm import client, MODEL


class ConversationIntelligence:

    def understand(self, message, history=None):
        history = history or []

        context = [
            {"role": item["role"], "content": item["content"][:1200]}
            for item in history[-8:]
            if item.get("role") in ("user", "assistant")
        ]

        system = """
You are NEXUS AI's Conversation Intelligence Engine.

Understand meaning, intent, and conversation context before routing.

Principles:
- Understand before responding.
- Verify before claiming.
- Ask before taking action.
- Never pretend to have capabilities you lack.
- Use conversation history to understand follow-up messages.
- Answer normal conversation directly without calling an agent.
- Ask one clear question when important information is missing.

Available agents:
enterprise: business, strategy, operations, projects.
personal: learning, career, planning, organization.
cybersecurity: defensive security and security analysis.

Return only a JSON object:
{
 "intent_type": "conversation",
 "agent": null,
 "response": "natural response",
 "clarifying_question": null,
 "understood_request": "what the user means"
}

Classify intent carefully using these definitions:

conversation:
Use only for greetings, casual conversation, or questions that can be
answered directly without an available agent.

agent_task:
Use when the user clearly requests work that an available agent can perform.
Examples:
- "Help me build a career plan based on my skills." -> personal
- "Analyze my company's business strategy." -> enterprise
- "Help me assess this phishing email." -> cybersecurity

clarification:
Use when the user's goal is understandable but important details are
missing before an agent can provide useful, tailored help.
Examples:
- "I feel stuck professionally and want a better-paying career.
  Help me find a practical path." -> clarification
- "Help me improve my business." -> clarification

unsupported:
Use when the request requires capabilities NEXUS does not have.

For agent_task, select exactly one available agent and set response to an empty string.
For clarification, set agent to null and ask one focused question.
For unsupported, set agent to null and explain the limitation honestly.
For conversation, answer naturally and set agent to null.
For conversation and agent_task, clarifying_question must be null.
Never classify a request for career, planning, business, or security help
as ordinary conversation merely because the user has not provided every detail.

Never claim external access, live monitoring, or verified security incidents without evidence.
"""

        messages = [
            {"role": "system", "content": system},
            {
                "role": "user",
                "content": (
                    "Previous conversation:\n"
                    + json.dumps(context, ensure_ascii=False)
                    + "\nCurrent message:\n"
                    + message
                )
            }
        ]

        try:
            result = client.chat.completions.create(
                model=MODEL,
                messages=messages,
                temperature=0.1
            )

            raw = result.choices[0].message.content or ""
            match = re.search(r"\{.*\}", raw, re.DOTALL)

            if not match:
                raise ValueError("Invalid JSON response from model.")

            data = json.loads(match.group(0))

            allowed = {
                "conversation", "agent_task",
                "clarification", "unsupported"
            }

            if data.get("intent_type") not in allowed:
                raise ValueError("Invalid intent type.")

            if data["intent_type"] == "agent_task":
                if data.get("agent") not in {
                    "enterprise", "personal", "cybersecurity"
                }:
                    raise ValueError("Invalid agent.")
            else:
                data["agent"] = None

            return data

        except Exception as error:
            return {
                "intent_type": "clarification",
                "agent": None,
                "response": (
                    "I couldn't reliably understand that request. "
                    "Could you explain what you mean?"
                ),
                "clarifying_question": None,
                "understood_request": "Unable to determine intent.",
                "reason": str(error)
            }


conversation_engine = ConversationIntelligence()
